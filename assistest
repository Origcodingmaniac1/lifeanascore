<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Subject Chatbot</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f4; }
        #chatContainer { width: 300px; height: 400px; border: 1px solid #ccc; overflow-y: auto; padding: 10px; background: white; }
        #userInput { width: 100%; padding: 10px; }
        #sendButton { padding: 10px; }
        .message { margin: 5px 0; }
        .user { text-align: right; }
        .bot { text-align: left; }
    </style>
</head>
<body>

    <h1>Dynamic Subject Chatbot</h1>
    <div id="chatContainer"></div>
    <input type="text" id="userInput" placeholder="Type your message..." />
    <button id="sendButton">Send</button>

    <script>
        const chatContainer = document.getElementById('chatContainer');
        const userInput = document.getElementById('userInput');
        const sendButton = document.getElementById('sendButton');

        let currentSubject = 'general';

        sendButton.addEventListener('click', () => {
            const userMessage = userInput.value;
            if (userMessage) {
                appendMessage(userMessage, 'user');
                getBotResponse(userMessage);
                userInput.value = '';
            }
        });

        function appendMessage(message, sender) {
            const messageElement = document.createElement('div');
            messageElement.classList.add('message', sender);
            messageElement.textContent = message;
            chatContainer.appendChild(messageElement);
            chatContainer.scrollTop = chatContainer.scrollHeight; // Scroll to the bottom
        }

        function switchSubject(subject) {
            currentSubject = subject;
            appendMessage(`Switched to ${subject} subject. How can I assist you?`, 'bot');
        }

        function correctTypo(message) {
            let normalizedMessage = message.replace(/\s+/g, ' ').trim();

            // A simple typo correction: common typos can be replaced
            const typos = {
                'hwlp': 'help',
                'mathh': 'math',
            };

            for (const [typo, correction] of Object.entries(typos)) {
                normalizedMessage = normalizedMessage.replace(new RegExp(`\\b${typo}\\b`, 'g'), correction);
            }

            return normalizedMessage;
        }

        function extractKeywords(message) {
            const keywords = [
                'hello', 'hi', 'hey', 'help', 'study', 'science', 
                'math', 'biology', 'cells', 'cell', 'structure', 
                'function', 'types', 'organelles', 'cell wall', 
                'chemistry', 'computer', 'history'
            ];
            const extractedKeywords = [];
            const normalizedMessage = message.toLowerCase().split(/\s+/); // Split into words

            normalizedMessage.forEach(word => {
                if (keywords.includes(word)) {
                    extractedKeywords.push(word);
                }
            });

            return extractedKeywords;
        }

        function generateResponse(keywords, userMessage) {
            if (keywords.includes('hello') || keywords.includes('hi') || keywords.includes('hey')) {
                return "Greetings! How may I assist you today?";
            }
            if (keywords.includes('help')) {
                return "What specific help do you need?";
            }
            if (keywords.includes('biology')) {
                switchSubject('biology');
                return "Biology is a fascinating subject! What topic in biology would you like to discuss?";
            }
            if (keywords.includes('math')) {
                switchSubject('math');
                return "Math is an important subject! What math problem do you need help with?";
            }
            if (keywords.includes('chemistry')) {
                switchSubject('chemistry');
                return "Chemistry is the study of matter. What topic in chemistry would you like to discuss?";
            }
            if (keywords.includes('computer')) {
                switchSubject('computer');
                return "Computer science involves the study of computers and algorithms. What topic would you like to explore?";
            }
            if (keywords.includes('history')) {
                switchSubject('history');
                return "History is the study of past events. What specific period or event are you interested in?";
            }
            if (currentSubject === 'math') {
                if (/^\d+\s*[\+\-\*\/]\s*\d+$/.test(userMessage)) {
                    return `The answer is ${eval(userMessage)}.`;
                }
                return "What math problem do you need help with?";
            }
            if (currentSubject === 'biology') {
                if (keywords.includes('cell wall')) {
                    return "The cell wall provides structure and protection to the cell. Would you like to know more about its composition or function?";
                }
                if (keywords.includes('organelles')) {
                    return "Organelles are specialized structures within a cell that perform distinct functions. Which organelle would you like to learn about?";
                }
            }
            return "I'm not sure how to assist with that. Please clarify.";
        }

        function getBotResponse(userMessage) {
            const correctedMessage = correctTypo(userMessage);
            const keywords = extractKeywords(correctedMessage);
            const response = generateResponse(keywords, correctedMessage);
            appendMessage(response, 'bot');
        }
    </script>

</body>
</html>
